---
// BC10 — ONE BILINGUAL ROOT 404.
//
// A per-locale src/pages/[lang]/404.astro would emit dist/{lang}/404/index.html
// under build.format:'directory' (withastro/astro#10423, closed as not planned) —
// a path that no Apache ErrorDocument and no platform 404 convention will ever
// serve. Only the ROOT src/pages/404.astro yields a real /404.html, so the 404 is
// multilingual by design rather than accidentally single-language for everyone.
// It renders one block per SHIPPED locale, so a new language appears here for free.
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SHIPPED_LOCALES, DEFAULT_LOCALE, LOCALE_TAGS } from '../i18n/locales.mjs';
import { useTranslations } from '../i18n/t';
---
<!doctype html>
<html lang={LOCALE_TAGS[DEFAULT_LOCALE] ?? DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Getcar Travel</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
  </head>
  <body class="grid min-h-screen place-items-center bg-neutral-50">
    <main class="max-w-xl px-4 text-center">
      {/* "404" IS the heading, and it is the only part of this page that means the
          same thing in every language — so it is the <h1>. Each locale block below
          is an <h2>. They were all <h1> before — two top-level headings in one
          document, and a third arriving with English. */}
      <h1 class="font-[family-name:var(--font-display)] text-6xl font-bold text-brand-300">404</h1>
      {SHIPPED_LOCALES.map((l) => {
        const t = useTranslations(l);
        return (
          /* Each block is in its own language, so it says so. Without `lang` a
             screen reader reads all of them with the document's phonemes — which
             was survivable at two locales and is not at three. */
          <section class="mt-8" lang={LOCALE_TAGS[l] ?? l}>
            <h2 class="text-xl font-semibold text-brand-900">{t('notFound.title')}</h2>
            <p class="mt-2 text-neutral-600">{t('notFound.body')}</p>
            <a href={getRelativeLocaleUrl(l, '/')} class="mt-3 inline-block font-medium text-brand-700 underline">
              {t('nav.home')}
            </a>
          </section>
        );
      })}
    </main>
  </body>
</html>
