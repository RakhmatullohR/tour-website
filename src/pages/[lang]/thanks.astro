---
// §5 — the post-submit target and the conversion anchor.
//
// noindex: this page exists for a visitor who has just converted, not for search.
// robots.txt disallows it too (§14) and the sitemap excludes it.
import Base from '../../layouts/Base.astro';
import { SHIPPED_LOCALES } from '../../i18n/locales.mjs';
import { useTranslations } from '../../i18n/t';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { PHONE_DISPLAY, telHref, telegramHref, whatsappHref } from '../../config/site';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';

export function getStaticPaths() {
  return SHIPPED_LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang!;
const t = useTranslations(lang);
const tg = telegramHref();
const wa = whatsappHref();
---
<Base
  locale={lang}
  title={`${t('thanks.title')} — ${t('site.name')}`}
  description={t('thanks.body')}
  availableLocales={SHIPPED_LOCALES}
  path="/thanks/"
  noindex
>
  <div class="mx-auto max-w-2xl px-4 py-20 text-center sm:py-28">
    <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-brand-700 text-white">
      <Icon name="check" size={32} />
    </span>
    <h1 class="mt-6 text-3xl font-bold text-brand-900 sm:text-4xl">{t('thanks.title')}</h1>
    <p class="mt-4 text-lg text-neutral-800">{t('thanks.body')}</p>

    <p class="mt-8 text-sm text-neutral-600">{t('thanks.faster')}</p>
    <ul class="mt-3 flex flex-wrap justify-center gap-3">
      <li>
        <a href={telHref()} data-metrica="phone_click"
          class="inline-flex min-h-12 items-center gap-2 rounded-[var(--radius-md)] border border-neutral-200 bg-white px-5 font-medium text-brand-700 hover:bg-neutral-100">
          <Icon name="phone" size={18} />{PHONE_DISPLAY}
        </a>
      </li>
      {tg && (
        <li>
          <a href={tg} target="_blank" rel="noopener noreferrer" data-metrica="telegram_click"
            class="inline-flex min-h-12 items-center gap-2 rounded-[var(--radius-md)] border border-neutral-200 bg-white px-5 font-medium text-brand-700 hover:bg-neutral-100">
            <Icon name="telegram" size={18} />Telegram
          </a>
        </li>
      )}
      {wa && (
        <li>
          <a href={wa} target="_blank" rel="noopener noreferrer" data-metrica="whatsapp_click"
            class="inline-flex min-h-12 items-center gap-2 rounded-[var(--radius-md)] border border-neutral-200 bg-white px-5 font-medium text-brand-700 hover:bg-neutral-100">
            <Icon name="whatsapp" size={18} />WhatsApp
          </a>
        </li>
      )}
    </ul>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <Button href={getRelativeLocaleUrl(lang, '/tours/')} variant="accent" size="lg">{t('thanks.tours')}</Button>
      <Button href={getRelativeLocaleUrl(lang, '/')} variant="secondary" size="lg">{t('thanks.home')}</Button>
    </div>
  </div>
</Base>
