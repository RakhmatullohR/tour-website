---
// PLAN §8.1 — routes live in src/pages/[lang]/ and are generated by
// getStaticPaths() over SHIPPED_LOCALES. Astro's i18n config is used FOR HELPERS
// ONLY (Astro.currentLocale, getRelativeLocaleUrl); i18n.routing.fallback is never
// relied upon. Verified sound: Astro.currentLocale is pathname-derived, so this
// route shape is first-class and supported.
//
// P0 SMOKE TEST: this page exercises a content collection with a glob() loader,
// an optimised <Image> from src/assets/images, the t() helper, hreflang, and the
// page-aware switcher. If `npm run build` is green, the stack lock holds.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SHIPPED_LOCALES } from '../../i18n/locales.mjs';
import { useTranslations } from '../../i18n/t';
import { tryResolveImage } from '../../lib/images';

export function getStaticPaths() {
  return SHIPPED_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang!);
const today = new Date().toISOString().slice(0, 10);

const tours = (await getCollection('tours'))
  .filter((e) => e.data.status === 'published')
  // §7.1 — a locale block that is absent means that page is NOT EMITTED and the
  // tour is not advertised in that language.
  .filter((e) => e.data.i18n[lang!] !== undefined)
  .sort((a, b) => a.data.order - b.data.order);

const fmt = (n: number, cur: string) =>
  new Intl.NumberFormat(lang === 'ru' ? 'ru-RU' : 'uz-UZ').format(n) + (cur === 'UZS' ? " so'm" : ' $');
---
<Base
  locale={lang!}
  title={`${t('site.name')} — ${t('site.tagline')}`}
  description={t('site.tagline')}
  availableLocales={SHIPPED_LOCALES}
  path="/"
>
  <section class="mx-auto max-w-[1240px] px-4 py-12">
    <h1 class="text-3xl font-bold text-brand-900 sm:text-4xl">{t('site.name')}</h1>
    <p class="mt-3 text-neutral-600">{t('site.tagline')}</p>

    <h2 class="mt-12 text-2xl font-bold text-brand-900">{t('nav.tours')}</h2>
    <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tours.map((tour) => {
        const b = tour.data.i18n[lang!]!;
        const cover = tryResolveImage(tour.data.images.cover);
        // §7.3 layer 1 — the BUILD-TIME CORRECTNESS FLOOR. Past departures are
        // dropped here, so the emitted HTML is correct as of the last build
        // whatever the browser does. Runtime JS narrows further; the weekly cron
        // keeps this floor from drifting more than seven days.
        const upcoming = tour.data.departures.filter((d) => d >= today);
        return (
          <li class="reveal overflow-hidden rounded-[var(--radius-lg)] border border-neutral-200 bg-white">
            {cover && (
              <Image src={cover} alt={b.title} widths={[400, 800]} sizes="(max-width: 640px) 100vw, 400px" format="webp" class="aspect-[3/2] w-full object-cover" />
            )}
            <div class="p-5">
              <h3 class="text-lg font-semibold text-brand-900">{b.title}</h3>
              <p class="mt-2 text-sm text-neutral-600">{b.summary}</p>
              <p class="mt-3 font-semibold text-brand-700">
                {fmt(tour.data.price.amount, tour.data.price.currency)}
                <span class="ml-1 text-xs font-normal text-neutral-400">{t('tour.perPerson')}</span>
              </p>
              {/* BC6 — the flight line renders FROM THE BOOLEAN through t(),
                  never from priceNote or any other free prose. */}
              <p class="mt-1 text-xs text-neutral-600">
                {tour.data.flightIncluded ? t('tour.flightIncluded') : t('tour.flightNotIncluded')}
              </p>
              <p class="mt-3 text-xs text-neutral-600">
                {upcoming.length === 0 ? (
                  t('tour.datesOnRequest')
                ) : (
                  <span data-departures-list data-empty-label={t('tour.datesOnRequest')}>
                    {t('tour.departures')}:{' '}
                    {upcoming.map((d) => (
                      <time datetime={d} data-departure class="mr-2 inline-block">{d}</time>
                    ))}
                  </span>
                )}
              </p>
            </div>
          </li>
        );
      })}
    </ul>
  </section>
</Base>
