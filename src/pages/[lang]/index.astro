---
// PLAN §6 — the Home page, all 13 sections, locale-aware.
//
// §8.1 — routes live in src/pages/[lang]/ and are generated by getStaticPaths()
// over SHIPPED_LOCALES. Astro's i18n config is used FOR HELPERS ONLY
// (Astro.currentLocale, getRelativeLocaleUrl); i18n.routing.fallback is never
// relied upon.
//
// EVERY STRING COMES FROM src/i18n/{locale}.json VIA t() (Principle 5). There is
// no hardcoded user-facing copy in any component — §18 greps for exactly that.
import Base from '../../layouts/Base.astro';
import { SHIPPED_LOCALES } from '../../i18n/locales.mjs';
import { useTranslations } from '../../i18n/t';
import { getToursFor, getDestinationsFor, getReviewsFor, getPromotionsFor } from '../../lib/tours';
import { travelAgencySchema } from '../../lib/seo';

import Hero from '../../components/sections/Hero.astro';
import QuickEnquiry from '../../components/sections/QuickEnquiry.astro';
import Services from '../../components/sections/Services.astro';
import PopularDestinations from '../../components/sections/PopularDestinations.astro';
import FeaturedTours from '../../components/sections/FeaturedTours.astro';
import WhyUs from '../../components/sections/WhyUs.astro';
import HowItWorks from '../../components/sections/HowItWorks.astro';
import PromoBanner from '../../components/sections/PromoBanner.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import CtaSection from '../../components/sections/CtaSection.astro';

export function getStaticPaths() {
  return SHIPPED_LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang!;
const t = useTranslations(lang);

const [tours, destinations, reviews, promotions] = await Promise.all([
  getToursFor(lang),
  getDestinationsFor(lang),
  getReviewsFor(lang),
  getPromotionsFor(lang),
]);

const description = t('site.description');
---
<Base
  locale={lang}
  title={`${t('site.name')} — ${t('site.tagline')}`}
  description={description}
  availableLocales={SHIPPED_LOCALES}
  path="/"
  schemas={[travelAgencySchema(Astro.site, lang, description)]}
>
  <Hero locale={lang} t={t} />
  <QuickEnquiry locale={lang} t={t} />
  <Services t={t} />
  <PopularDestinations destinations={destinations} tours={tours} locale={lang} t={t} />
  <FeaturedTours tours={tours} locale={lang} t={t} />
  <WhyUs t={t} />
  <HowItWorks t={t} />
  <PromoBanner promotions={promotions} locale={lang} t={t} />
  <Testimonials reviews={reviews} locale={lang} t={t} />
  <CtaSection locale={lang} t={t} />
</Base>
