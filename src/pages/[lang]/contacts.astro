---
// §5 / §10 — Contacts: every channel, the static map, hours, and a lead form.
//
// §10: THE MAP IS A STATIC IMAGE + a link out, never an embedded iframe. An embed
// costs roughly 500 KB and destroys LCP for a map almost nobody interacts with.
// The map card and the address block BOTH auto-hide while Q22 is unanswered.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SHIPPED_LOCALES } from '../../i18n/locales.mjs';
import { useTranslations } from '../../i18n/t';
import { resolveImage } from '../../lib/images';
import { travelAgencySchema, breadcrumbSchema } from '../../lib/seo';
import { PHONE_DISPLAY, telHref, telegramHref, telegramChannelHref, whatsappHref, whatsappDisplay, instagramHref, youtubeHref, youtubeDisplay, mailtoHref, EMAIL, SOCIAL, ADDRESS, HOURS } from '../../config/site';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Icon from '../../components/ui/Icon.astro';
import LeadForm from '../../components/forms/LeadForm.astro';

export function getStaticPaths() {
  return SHIPPED_LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang!;
const t = useTranslations(lang);
const map = resolveImage('static-map-800x500.webp');

const crumbs = [
  { name: t('breadcrumb.home'), path: `/${lang}/` },
  { name: t('contacts.title'), path: `/${lang}/contacts/` },
];

const tg = telegramHref();
const tgChannel = telegramChannelHref();
const wa = whatsappHref();
const ig = instagramHref();
const yt = youtubeHref();
const mail = mailtoHref();
// ORDER IS DELIBERATE, and the grid is 2-up on >=sm, so it reads across the row,
// not down the column: the channels that REACH A MANAGER come first (phone,
// WhatsApp, Telegram — the same claim `contacts.subtitle` makes), then the
// follow-only ones (the Telegram channel, Instagram, YouTube). Inserting a new
// channel in the middle silently moves everything after it — put lead channels
// above the divide, follow channels below it.
//
// EMAIL WAS THE FOURTH LEAD CHANNEL and was withdrawn on 2026-08-26 at the
// client's instruction. The row below is kept, not deleted, because it is gated
// on `mail` — which is null while EMAIL is null (see config/site.ts). Setting a
// real address there restores this card in its original position, and nothing
// else has to change. `contacts.subtitle` no longer promises email either.
const channels = [
  { href: telHref(), label: t('contacts.phone'), value: PHONE_DISPLAY, icon: 'phone' as const, event: 'phone_click', external: false },
  wa && { href: wa, label: t('contacts.whatsapp'), value: whatsappDisplay()!, icon: 'whatsapp' as const, event: 'whatsapp_click', external: true },
  tg && { href: tg, label: t('contacts.telegram'), value: `@${SOCIAL.telegram}`, icon: 'telegram' as const, event: 'telegram_click', external: true },
  mail && { href: mail, label: t('contacts.email'), value: EMAIL!, icon: 'mail' as const, event: 'email_click', external: false },
  /* --- below here: follow-only, no lead reaches a manager through these --- */
  tgChannel && { href: tgChannel, label: t('contacts.telegramChannel'), value: `@${SOCIAL.telegramChannel}`, icon: 'telegram-channel' as const, event: null, external: true },
  ig && { href: ig, label: t('contacts.instagram'), value: `@${SOCIAL.instagram}`, icon: 'instagram' as const, event: null, external: true },
  yt && { href: yt, label: t('contacts.youtube'), value: youtubeDisplay()!, icon: 'youtube' as const, event: null, external: true },
].filter(Boolean) as { href: string; label: string; value: string; icon: 'phone' | 'telegram' | 'telegram-channel' | 'whatsapp' | 'mail' | 'instagram' | 'youtube'; event: string | null; external: boolean }[];
---
<Base
  locale={lang}
  title={`${t('contacts.title')} — ${t('site.name')}`}
  description={t('contacts.subtitle')}
  availableLocales={SHIPPED_LOCALES}
  path="/contacts/"
  schemas={[travelAgencySchema(Astro.site, lang, t('contacts.subtitle')), breadcrumbSchema(Astro.site, crumbs)]}
>
  <div class="mx-auto max-w-[var(--container-site)] px-4 py-10 sm:px-6 sm:py-14">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4 text-3xl font-bold text-brand-900 sm:text-4xl">{t('contacts.title')}</h1>
    <p class="mt-3 max-w-[68ch] text-neutral-600">{t('contacts.subtitle')}</p>

    <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                data-metrica={c.event}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener noreferrer' : undefined}
                class="flex min-h-[76px] items-center gap-3 rounded-[var(--radius-lg)] border border-neutral-200 bg-white p-4 hover:border-brand-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
              >
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-[var(--radius-md)] bg-brand-300/20 text-brand-700">
                  <Icon name={c.icon} size={22} />
                </span>
                <span class="min-w-0">
                  <span class="block text-xs text-neutral-600">{c.label}</span>
                  <span class="block truncate font-medium text-brand-900">{c.value}</span>
                  {c.external && <span class="sr-only"> ({t('common.newTab')})</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>

        {HOURS && (
          <div class="mt-6 flex items-start gap-3 rounded-[var(--radius-lg)] border border-neutral-200 p-4">
            <Icon name="clock" size={22} class="mt-0.5 shrink-0 text-brand-700" />
            <span>
              <span class="block text-xs text-neutral-600">{t('contacts.hours')}</span>
              <span class="font-medium text-brand-900">{lang === 'ru' ? HOURS.ru : HOURS.uz}</span>
            </span>
          </div>
        )}

        {/* Auto-hides while the office address is unknown (Q22, BC12b). A map
            image with no address under it is worse than no map. */}
        {ADDRESS && (
          <section aria-labelledby="map-h" class="mt-6">
            <h2 id="map-h" class="text-lg font-bold text-brand-900">{t('contacts.address')}</h2>
            <p class="mt-2 text-neutral-800">{lang === 'ru' ? ADDRESS.ru : ADDRESS.uz}</p>
            <a href={ADDRESS.mapUrl} target="_blank" rel="noopener noreferrer" class="mt-3 block overflow-hidden rounded-[var(--radius-lg)] border border-neutral-200">
              <Image src={map} alt={t('contacts.mapAlt')} width={800} widths={[400, 800]} sizes="(max-width: 1024px) 100vw, 560px"
                format="webp" loading="lazy" class="w-full object-cover" />
              <span class="block bg-white p-3 text-sm font-medium text-brand-700">
                {t('contacts.mapOpen')}<span class="sr-only"> ({t('common.newTab')})</span>
              </span>
            </a>
          </section>
        )}
      </div>

      <section aria-labelledby="cform-h" class="rounded-[var(--radius-lg)] border border-neutral-200 bg-white p-6 sm:p-8">
        <h2 id="cform-h" class="text-2xl font-bold text-brand-900">{t('contacts.formTitle')}</h2>
        <LeadForm variant="lead" locale={lang} t={t} class="mt-5" />
      </section>
    </div>
  </div>
</Base>
