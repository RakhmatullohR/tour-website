---
// §8 — inline SVG, no icon-font payload. Every path is 24x24, stroke-based, so a
// single set of attributes styles all of them and they inherit currentColor.
interface Props { name: keyof typeof PATHS; size?: number; class?: string; }
const { name, size = 24, class: cls = '' } = Astro.props;

const PATHS = {
  // Home §6 row 4 — the six service icons. These are why the six Tier-2
  // "service photos" were dropped: this block renders icons, not photographs.
  tours: '<path d="M9 20l-5.5 2V6L9 4m0 16l6-2m-6 2V4m6 14l5.5 2V4L15 6m0 12V6m0 0L9 4"/>',
  hotel: '<path d="M3 20v-8a2 2 0 012-2h14a2 2 0 012 2v8M3 20h18M3 20v-2m18 2v-2M7 10V7a2 2 0 012-2h6a2 2 0 012 2v3"/><circle cx="8.5" cy="14.5" r="1.5"/>',
  insurance: '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  transfer: '<path d="M5 17h14M5 17a2 2 0 11-4 0 2 2 0 014 0zm14 0a2 2 0 104 0 2 2 0 00-4 0z"/><path d="M3 17v-4l2-5h11l3 5h2v4"/><path d="M8 8v4M13 8v4"/>',
  guide: '<circle cx="12" cy="8" r="3.5"/><path d="M5 21v-1a7 7 0 0114 0v1"/>',
  meals: '<path d="M6 3v8a2 2 0 002 2h0a2 2 0 002-2V3M8 13v8M6 3v4m4-4v4"/><path d="M17 3c-1.5 1.5-2 3.5-2 6s.5 3 2 3v9"/>',
  // Contact + UI
  phone: '<path d="M4 4h4l2 5-2.5 1.5a12 12 0 006 6L15 14l5 2v4a1 1 0 01-1 1A16 16 0 013 5a1 1 0 011-1z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7.5l9 6 9-6"/>',
  telegram: '<path d="M21 4L3 11l5 2 2 6 3-4 5 4 3-15z"/><path d="M8 13l10-7-6 9"/>',
  whatsapp: '<path d="M3 21l1.6-4.4A8 8 0 1121 12a8 8 0 01-11.6 7.1L3 21z"/><path d="M8.5 9c0 4 2.5 6.5 6.5 6.5"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.5"/><circle cx="17" cy="7" r="1"/>',
  youtube: '<rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="M10 9l5 3-5 3V9z"/>',
  map: '<path d="M9 20l-5.5 2V6L9 4l6 2 5.5-2v16L15 22l-6-2z"/><path d="M9 4v16M15 6v16"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  check: '<path d="M4 12l5 5L20 6"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  chevronDown: '<path d="M6 9l6 6 6-6"/>',
  arrowRight: '<path d="M4 12h16M14 6l6 6-6 6"/>',
  star: '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z"/>',
  users: '<circle cx="9" cy="8" r="3.5"/><path d="M2 20v-1a7 7 0 0114 0v1"/><path d="M16 5.5a3.5 3.5 0 010 5M17.5 20v-1a7 7 0 00-1.5-4.3"/>',
  plane: '<path d="M10 20l2-5 8-3 2-3-4 .5L12 12 4 9l-2 2 6 3-1 5 2 1z"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z"/>',
} as const;
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={PATHS[name]}
/>
