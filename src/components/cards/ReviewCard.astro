---
// §13.4 ReviewCard. Only REAL reviews ever reach this component — getReviewsFor()
// drops everything with real:false, so a sample can never be mistaken for a
// client quote (Q14).
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { tryResolveImage } from '../../lib/images';
import Icon from '../ui/Icon.astro';

interface Props { review: CollectionEntry<'reviews'>; locale: string }
const { review, locale } = Astro.props;
const d = review.data;
const b = d.i18n[locale]!;
const avatar = tryResolveImage(d.avatar);
---
<figure class="reveal flex h-full flex-col gap-4 rounded-[var(--radius-lg)] border border-neutral-200 bg-white p-6">
  <div class="flex gap-0.5 text-accent-600" role="img" aria-label={`${d.rating}/5`}>
    {Array.from({ length: d.rating }).map(() => <Icon name="star" size={18} class="fill-current" />)}
  </div>
  <blockquote class="flex-1 text-neutral-800">{b.text}</blockquote>
  <figcaption class="flex items-center gap-3">
    {avatar && <Image src={avatar} alt="" width={44} height={44} format="webp" loading="lazy" class="h-11 w-11 rounded-full object-cover" />}
    <span>
      <span class="block text-sm font-semibold text-brand-900">{d.author}</span>
      {b.role && <span class="block text-xs text-neutral-600">{b.role}</span>}
    </span>
  </figcaption>
</figure>
