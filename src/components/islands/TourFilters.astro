---
// §5 / Gate 1 — catalogue filters over country, duration, price and category.
//
// PROGRESSIVE ENHANCEMENT, NOT A JS APP. The server emits every card; these
// controls only add `hidden` to the ones that do not match. With JS disabled the
// whole control block is hidden (it would do nothing) and the full list stands.
//
// The option sets are DERIVED FROM THE TOURS ACTUALLY ON THE PAGE, so a filter can
// never offer a country with zero results.
import type { TFunction } from '../../i18n/t';
import { pluralUnit } from '../../lib/format';
import { durationFacet, durationLadderGroups, priceUZS, PRICE_STEPS_MLN, PRICE_STEP_UNIT, type Tour } from '../../lib/tours';

interface Props { tours: Tour[]; locale: string; t: TFunction; class?: string }
const { tours, locale, t, class: cls = '' } = Astro.props;

const uniq = <T,>(xs: T[]) => [...new Set(xs)];
const countries = uniq(tours.map((x) => x.data.country)).sort();
const categories = uniq(tours.map((x) => x.data.category)).sort();
// THE DURATION MENU IS GROUPED BY SCOPE (client instruction, 2026-08-26): one
// <select> whose <optgroup>s are "Oʻzbekistonda" and "Xorijda", each listing the
// lengths sold there. The ladder itself lives in lib/tours.ts.
//
// <optgroup> and not two selects: the client stated it as one list, it is one
// question ("where and for how long"), it costs one control's worth of header
// room instead of two, and it needs no JavaScript to group — which matters here
// because this whole panel is progressive enhancement.
//
// Rungs with no tour on the page are dropped, and a group that empties out
// disappears with them — the same rule the country and category menus follow, so
// the filter can never offer a length that returns nothing.
const present = new Set(tours.map((x) => durationFacet(x.data.country, x.data.duration.days)));
const durationGroups = durationLadderGroups()
  .map((g) => ({ ...g, rungs: g.rungs.filter((r) => present.has(r.value)) }))
  .filter((g) => g.rungs.length > 0);

// The price ceiling ladder (see PRICE_STEPS_MLN). The last rung is only offered
// when something on the page actually costs more than it — without that check the
// list would end on an option that can never narrow anything.
const dearest = tours.length ? Math.max(...tours.map((x) => priceUZS(x.data.price.amount, x.data.price.currency))) : 0;
const priceOptions = PRICE_STEPS_MLN.map((n) => ({
  value: String(n * PRICE_STEP_UNIT),
  label: t('catalog.price.upTo', { n }),
}));
if (dearest > PRICE_STEPS_MLN[PRICE_STEPS_MLN.length - 1] * PRICE_STEP_UNIT)
  priceOptions.push({ value: String(Number.MAX_SAFE_INTEGER), label: t('catalog.price.above', { n: PRICE_STEPS_MLN[PRICE_STEPS_MLN.length - 1] }) });

/** One entry per <select>, IN THE ORDER THEY RENDER. A menu carries either a flat
 *  `options` list or grouped `optgroups`; the template picks per entry, so adding,
 *  removing or reordering a filter is a change to this array alone. */
type Option = { value: string; label: string };
const groups: { key: string; label: string; options?: Option[]; optgroups?: { label: string; options: Option[] }[] }[] = [
  { key: 'country', label: t('catalog.filter.country'), options: countries.map((c) => ({ value: c, label: t(`country.${c}`) })) },
  { key: 'category', label: t('catalog.filter.category'), options: categories.map((c) => ({ value: c, label: t(`category.${c}`) })) },
  {
    key: 'duration',
    label: t('catalog.filter.duration'),
    optgroups: durationGroups.map((g) => ({
      label: t(`catalog.scope.${g.scope}`),
      options: g.rungs.map((r) => ({
        value: r.value,
        label: t('catalog.duration.days', { n: r.days, unit: pluralUnit('day', r.days, locale) }),
      })),
    })),
  },
  { key: 'price', label: t('catalog.filter.price'), options: priceOptions },
  // A menu with nothing to offer is not rendered — that is what used to drop the
  // duration filter when every tour shared a bucket, and it still applies now
  // that the rungs are the client's ladder.
].filter((g) => (g.options?.length ?? 0) > 0 || (g.optgroups?.length ?? 0) > 0);
---
{/* Hidden by the `html:not(.js)` rule in global.css, NOT by a JS toggle.
    A control that cannot work should not be on the page at all — but unhiding it
    from script reflows the grid below it, which measured CLS 0.372 against a
    0.1 budget. The BC11 `html.js` marker is set in <head> before any stylesheet,
    so with JS the panel is visible at FIRST PAINT and nothing moves. */}
<section data-filters aria-labelledby="filters-h" class={cls}>
  <h2 id="filters-h" class="sr-only">{t('catalog.filters')}</h2>

  <div class="grid gap-4 rounded-[var(--radius-lg)] border border-neutral-200 bg-white p-5 sm:grid-cols-2 lg:grid-cols-4">
    {groups.map((g) => (
      <div class="flex flex-col gap-1.5">
        <label for={`filter-${g.key}`} class="text-sm font-medium text-neutral-800">{g.label}</label>
        <select
          id={`filter-${g.key}`}
          data-filter={g.key}
          class="min-h-12 w-full rounded-[var(--radius-md)] border border-neutral-200 bg-white px-4 text-neutral-900 focus:border-brand-500 focus:outline-2 focus:outline-brand-500"
        >
          <option value="">{t('catalog.filter.all')}</option>
          {g.options?.map((o) => <option value={o.value}>{o.label}</option>)}
          {g.optgroups?.map((og) => (
            <optgroup label={og.label}>
              {og.options.map((o) => <option value={o.value}>{o.label}</option>)}
            </optgroup>
          ))}
        </select>
      </div>
    ))}
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-4">
    <p data-filter-count aria-live="polite" class="text-sm text-neutral-600"></p>
    <button
      type="button"
      data-filter-reset
      class="min-h-11 rounded-[var(--radius-md)] px-3 text-sm font-medium text-brand-700 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
    >
      {t('catalog.filter.reset')}
    </button>
  </div>
</section>

<script is:inline define:vars={{ resultsTemplate: t('catalog.results', { n: '{n}' }) }}>
  (function () {
    // The tour grid is rendered AFTER this component, so at parse time
    // [data-tour-grid] does not exist yet. Running immediately made every query
    // return null, the function bail out, and the panel stay hidden — dead
    // filters and a broken heading order. Wait for the document instead.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function init() {
    var panel = document.querySelector('[data-filters]');
    var grid = document.querySelector('[data-tour-grid]');
    if (!panel || !grid) return;

    var selects = Array.prototype.slice.call(panel.querySelectorAll('[data-filter]'));
    var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-tour]'));
    var empty = document.querySelector('[data-tour-empty]');
    var count = panel.querySelector('[data-filter-count]');

    function apply() {
      var active = {};
      selects.forEach(function (s) { if (s.value) active[s.dataset.filter] = s.value; });

      var shown = 0;
      cards.forEach(function (card) {
        var ok = Object.keys(active).every(function (k) {
          // Price is a CEILING, not an equality: the option value is the maximum
          // soʻm the customer wants to pay. Every other facet is an exact match.
          if (k === 'price') return Number(card.dataset.priceUzs) <= Number(active[k]);
          return card.dataset[k] === active[k];
        });
        var li = card.closest('li') || card;
        li.hidden = !ok;
        if (ok) shown++;
      });

      if (empty) empty.hidden = shown !== 0;
      if (count) count.textContent = resultsTemplate.replace('{n}', String(shown));

      // Reflect state in the URL so a filtered view is linkable and survives a
      // back/forward navigation. replaceState: filtering is not a new page.
      var params = new URLSearchParams();
      Object.keys(active).forEach(function (k) { params.set(k, active[k]); });
      var qs = params.toString();
      history.replaceState(null, '', qs ? '?' + qs : location.pathname);
    }

    // Restore from the URL on load, so a shared filtered link opens filtered.
    var initial = new URLSearchParams(location.search);
    selects.forEach(function (s) {
      var v = initial.get(s.dataset.filter);
      if (v) s.value = v;
      s.addEventListener('change', apply);
    });

    var reset = panel.querySelector('[data-filter-reset]');
    if (reset) reset.addEventListener('click', function () {
      selects.forEach(function (s) { s.value = ''; });
      apply();
    });

    apply();
    }
  })();
</script>
