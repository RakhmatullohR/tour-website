---
// §13.4 Gallery / Lightbox.
//
// NO-JS SAFE: the grid is real <img> markup and every thumbnail is a link to the
// full image, so with JS off a visitor still sees and can open every photograph.
// The lightbox is built on <dialog>, so focus trapping and Esc come from the
// platform rather than from hand-rolled JS that usually gets them wrong.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { images: ImageMetadata[]; title: string; class?: string }
const { images, title, class: cls = '' } = Astro.props;
---
<section aria-labelledby="gallery-h" class={cls} data-gallery>
  <h2 id="gallery-h" class="text-xl font-bold text-brand-900">{title}</h2>

  <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
    {images.map((img, i) => (
      <li>
        <a href={img.src} data-gallery-item={i}
          class="block overflow-hidden rounded-[var(--radius-md)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700">
          <Image src={img} alt="" width={600} widths={[300, 600]} sizes="(max-width: 640px) 50vw, 240px" format="webp"
            loading="lazy" class="aspect-[3/2] w-full object-cover transition-transform duration-400 hover:scale-[1.03] motion-reduce:transform-none" />
        </a>
      </li>
    ))}
  </ul>

  <dialog data-lightbox class="max-h-[90dvh] max-w-[92vw] rounded-[var(--radius-lg)] bg-transparent p-0 backdrop:bg-black/80">
    <img data-lightbox-img alt="" class="max-h-[90dvh] max-w-[92vw] rounded-[var(--radius-lg)] object-contain" />
    <form method="dialog" class="absolute top-2 right-2">
      <button
        class="grid h-11 w-11 place-items-center rounded-full bg-white/90 text-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        aria-label="×"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"
          stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </form>
  </dialog>
</section>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]');
    const img = gallery.querySelector<HTMLImageElement>('[data-lightbox-img]');
    if (!dialog || !img || typeof dialog.showModal !== 'function') continue;

    gallery.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-gallery-item]');
      if (!link) return;
      e.preventDefault(); // the href stays as the no-JS fallback
      img.src = link.href;
      dialog.showModal(); // <dialog> gives focus trapping and Esc for free
    });

    // Click the backdrop to close. The <img> sits inside, so a click that lands
    // on the dialog element itself is necessarily outside the image.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
