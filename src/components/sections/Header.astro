---
// Home §6 row 1 — sticky header, condenses on scroll, full-screen drawer on mobile.
//
// THE DRAWER IS BUILT ON <details>, NOT ON JS (BC11 discipline). A JS-only drawer
// leaves a phone visitor with JavaScript off unable to reach any page but this one.
// JS then upgrades it: Esc closes, and it closes on navigation.
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { TFunction } from '../../i18n/t';
import { PHONE_DISPLAY, telHref, BRAND_NAME } from '../../config/site';
import { resolveImage } from '../../lib/images';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const logo = resolveImage('logo-getcar-512x512.png');

interface Props { locale: string; t: TFunction; availableLocales: string[]; path: string }
const { locale, t, availableLocales, path } = Astro.props;

const nav = [
  { key: 'nav.tours', href: '/tours/' },
  { key: 'nav.destinations', href: '/destinations/' },
  { key: 'nav.promotions', href: '/promotions/' },
  { key: 'nav.about', href: '/about/' },
  { key: 'nav.contacts', href: '/contacts/' },
] as const;

const isCurrent = (href: string) => path === href;
---
{/* NO `backdrop-blur` on this element, deliberately. `backdrop-filter` makes an
    element a CONTAINING BLOCK for its `position: fixed` descendants — so the
    drawer panel below, which asks for `top: var(--header-h); bottom: 0`, resolved
    those against the 64 px-tall header instead of the viewport and collapsed to
    zero height. The mobile menu opened onto a sliver showing one and a half
    links. At `bg-white/95` the blur was doing almost nothing visually anyway,
    while costing a compositing pass on every scroll frame on exactly the low-end
    Android hardware this site is built for. */}
<header
  data-header
  class="sticky top-0 z-40 border-b border-neutral-200 bg-white/95 transition-shadow duration-250 data-[scrolled]:shadow-sm"
>
  <div class="mx-auto flex max-w-[var(--container-site)] min-w-0 items-center gap-2 px-4 py-3 sm:gap-3 transition-[padding] duration-250 data-[scrolled]:py-2 sm:px-6">
    <a
      href={getRelativeLocaleUrl(locale, '/')}
      class="flex shrink-0 items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-700"
    >
      {/* The client's mark. `width`/`height` are set so the row reserves the box
          before the PNG decodes — a logo that pops in is a CLS on every page. */}
      <Image
        src={logo}
        alt=""
        width={40}
        height={40}
        densities={[1, 2]}
        loading="eager"
        class="h-9 w-9 shrink-0 rounded-full sm:h-10 sm:w-10"
      />
      <span class="font-[family-name:var(--font-display)] text-base font-bold whitespace-nowrap text-brand-900 sm:text-lg xl:text-xl">
        Getcar<span class="text-brand-600">Travel</span>
      </span>
      <span class="sr-only"> — {BRAND_NAME}</span>
    </a>

    {/* THE ROW MUST NEVER WRAP A LABEL (client report, 2026-08-26).
        Two things were needed, not one:
          1. `whitespace-nowrap` on the link — without it "Tur paketlari" and
             "Biz haqimizda" broke across two lines and pushed the header to 80 px.
          2. Room for the un-wrapped labels to fit. Uzbek is the widest locale, and
             at 1280 px the five nowrap labels + logo + switcher + CTA + phone
             overflow, which is worse than wrapping. So the horizontal padding and
             font-size step up only at `xl`, and the phone number — the one item
             that is duplicated in the drawer and the footer — stays out of the row
             until `2xl`, where there is measurably space for it. */}
    <nav aria-label={t('nav.menu')} class="ml-auto hidden lg:block">
      <ul class="flex flex-nowrap items-center gap-0.5 xl:gap-1">
        {nav.map((item) => (
          <li class="shrink-0">
            <a
              href={getRelativeLocaleUrl(locale, item.href)}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="inline-flex min-h-11 items-center rounded-[var(--radius-sm)] px-2 text-sm whitespace-nowrap text-neutral-800 hover:bg-neutral-100 aria-[current=page]:font-semibold aria-[current=page]:text-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700 xl:px-3 xl:text-base"
            >
              {t(item.key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2 lg:ml-0">
      <a
        href={telHref()}
        data-metrica="phone_click"
        class="hidden min-h-11 items-center gap-1.5 rounded-[var(--radius-sm)] px-2 font-medium whitespace-nowrap text-brand-700 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700 md:inline-flex lg:hidden 2xl:inline-flex"
      >
        <Icon name="phone" size={18} />{PHONE_DISPLAY}
      </a>

      <LanguageSwitcher locale={locale} availableLocales={availableLocales} path={path} compact />

      {/* The wrapper — not a `hidden` class on the Button — is what hides this.
          Button's base class sets `inline-flex`, and which of `.hidden` /
          `.inline-flex` wins is decided by ORDER IN THE STYLESHEET, not by the
          order of the class attribute. `.inline-flex` won, so the CTA stayed
          visible at 360 px and pushed the header 66 px past the viewport.
          `sm:contents` makes the wrapper generate no box at >= sm, so the layout
          above that breakpoint is byte-for-byte what it was. */}
      <span class="hidden sm:contents">
        <Button href={getRelativeLocaleUrl(locale, '/contacts/')} variant="accent" size="sm">
          {t('cta.request')}
        </Button>
      </span>

      {/* Mobile drawer. <details> so it opens with JS disabled. */}
      <details data-drawer class="lg:hidden">
        <summary
          aria-label={t('nav.menu')}
          class="grid h-11 w-11 cursor-pointer place-items-center rounded-[var(--radius-sm)] text-brand-900 marker:content-none hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700"
        >
          <Icon name="menu" class="block [details[open]_&]:hidden" />
          <Icon name="close" class="hidden [details[open]_&]:block" />
        </summary>

        <div class="hidden [details[open]_&]:block fixed inset-x-0 top-[var(--header-h,64px)] bottom-0 z-50 overflow-y-auto bg-white px-4 pt-2 pb-8">
          <nav aria-label={t('nav.menu')}>
            <ul class="flex flex-col">
              {nav.map((item) => (
                <li class="border-b border-neutral-100">
                  <a
                    href={getRelativeLocaleUrl(locale, item.href)}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    class="flex min-h-14 items-center text-lg text-neutral-800 aria-[current=page]:font-semibold aria-[current=page]:text-brand-700"
                  >
                    {t(item.key)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="mt-6 flex flex-col gap-3">
            <Button href={getRelativeLocaleUrl(locale, '/contacts/')} variant="accent" size="lg">{t('cta.request')}</Button>
            <Button href={telHref()} variant="secondary" size="lg" data-metrica="phone_click">
              <Icon name="phone" size={18} />{PHONE_DISPLAY}
            </Button>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const drawer = document.querySelector<HTMLDetailsElement>('[data-drawer]');

  // Publish the real header height so the drawer panel starts exactly below it,
  // at every breakpoint and in both the condensed and expanded states.
  const syncHeight = () => {
    if (header) document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
  };
  syncHeight();
  addEventListener('resize', syncHeight, { passive: true });

  // Condense on scroll (§6 row 1). Threshold, not a per-pixel transform, so this
  // never fights `prefers-reduced-motion`.
  if (header) {
    const onScroll = () => {
      if (scrollY > 8) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
      syncHeight();
    };
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });
  }

  if (drawer) {
    // §15 keyboard: Esc closes and focus returns to the trigger.
    addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !drawer.open) return;
      drawer.open = false;
      drawer.querySelector('summary')?.focus();
    });
    // Body scroll lock while the full-screen panel is open.
    drawer.addEventListener('toggle', () => {
      document.body.style.overflow = drawer.open ? 'hidden' : '';
    });
  }
</script>
