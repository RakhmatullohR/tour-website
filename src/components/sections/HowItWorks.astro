---
// Home §6 row 8 — four steps.
//
// THIS IS WHERE THE PAYMENT STORY IS TOLD HONESTLY (§6 row 8, ADR). The site takes
// no card payments; step 4 says so, and the note under the steps says it again in
// plain language rather than leaving the customer to discover it at checkout.
import type { TFunction } from '../../i18n/t';

interface Props { t: TFunction }
const { t } = Astro.props;

const steps = [
  { title: 'how.step1.title', text: 'how.step1.text' },
  { title: 'how.step2.title', text: 'how.step2.text' },
  { title: 'how.step3.title', text: 'how.step3.text' },
  { title: 'how.step4.title', text: 'how.step4.text' },
] as const;
---
<section aria-labelledby="how-h" class="bg-white py-16 sm:py-20">
  <div class="mx-auto max-w-[var(--container-site)] px-4 sm:px-6">
    <h2 id="how-h" class="text-3xl font-bold text-brand-900 sm:text-4xl">{t('how.title')}</h2>
    <p class="mt-3 max-w-[68ch] text-neutral-600">{t('how.subtitle')}</p>

    <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <li class="reveal relative rounded-[var(--radius-lg)] border border-neutral-200 p-6">
          <span
            aria-hidden="true"
            class="font-[family-name:var(--font-display)] text-4xl leading-none font-bold text-brand-300"
          >{i + 1}</span>
          <h3 class="mt-3 font-semibold text-brand-900">{t(s.title)}</h3>
          <p class="mt-2 text-sm text-neutral-600">{t(s.text)}</p>
        </li>
      ))}
    </ol>

    <p class="mt-6 rounded-[var(--radius-md)] border border-neutral-200 bg-neutral-50 p-4 text-sm text-neutral-800">
      {t('how.paymentNote')}
    </p>
  </div>
</section>
