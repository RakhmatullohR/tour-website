---
// Home §6 row 5 — six country cards with tour count and a "from" price.
// Both figures are DERIVED from the tour collection, never authored, so they can
// never contradict the catalogue.
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { TFunction } from '../../i18n/t';
import { fromPrice, type Destination, type Tour } from '../../lib/tours';
import DestinationCard from '../cards/DestinationCard.astro';
import Button from '../ui/Button.astro';

interface Props { destinations: Destination[]; tours: Tour[]; locale: string; t: TFunction }
const { destinations, tours, locale, t } = Astro.props;
const featured = destinations.filter((d) => d.data.featured).slice(0, 6);
---
{featured.length > 0 && (
  <section aria-labelledby="dest-h" class="bg-neutral-50 py-16 sm:py-20">
    <div class="mx-auto max-w-[var(--container-site)] px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="dest-h" class="text-3xl font-bold text-brand-900 sm:text-4xl">{t('destinations.title')}</h2>
          <p class="mt-3 max-w-[68ch] text-neutral-600">{t('destinations.subtitle')}</p>
        </div>
        <Button href={getRelativeLocaleUrl(locale, '/destinations/')} variant="ghost">{t('destinations.all')}</Button>
      </div>

      <ul class="mt-10 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-3">
        {featured.map((d) => (
          <li><DestinationCard destination={d} locale={locale} t={t} from={fromPrice(tours, d.data.country)} /></li>
        ))}
      </ul>
    </div>
  </section>
)}
