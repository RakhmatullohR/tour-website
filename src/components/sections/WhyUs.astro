---
// Home §6 row 7 — four differentiators.
//
// GROUNDED IN REAL ADVANTAGES, NOT INVENTED ONES (§6: "Confirm; do not invent").
// The transport-fleet claim rests on the "Getcar" trading name; guide, insurance
// and direct-manager contact are all in the client's own answers. Nothing here
// asserts a number, an award or a certification that has not been supplied.
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/images';
import type { TFunction } from '../../i18n/t';
import Icon from '../ui/Icon.astro';

interface Props { t: TFunction }
const { t } = Astro.props;
const img = resolveImage('about-team-1600x900.webp');

const points = [
  { icon: 'transfer', title: 'why.fleet.title', text: 'why.fleet.text' },
  { icon: 'guide', title: 'why.guide.title', text: 'why.guide.text' },
  { icon: 'shield', title: 'why.insurance.title', text: 'why.insurance.text' },
  { icon: 'users', title: 'why.manager.title', text: 'why.manager.text' },
] as const;
---
<section aria-labelledby="why-h" class="bg-neutral-50 py-16 sm:py-20">
  <div class="mx-auto grid max-w-[var(--container-site)] items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
    <div class="reveal overflow-hidden rounded-[var(--radius-lg)]">
      <Image src={img} alt={t('why.imageAlt')} widths={[640, 1000]} sizes="(max-width: 1024px) 100vw, 560px"
        format="webp" loading="lazy" class="aspect-[16/9] w-full object-cover" />
    </div>

    <div>
      <h2 id="why-h" class="text-3xl font-bold text-brand-900 sm:text-4xl">{t('why.title')}</h2>
      <p class="mt-3 text-neutral-600">{t('why.subtitle')}</p>

      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        {points.map((p) => (
          <li class="reveal">
            <span class="grid h-11 w-11 place-items-center rounded-[var(--radius-md)] bg-brand-700 text-white">
              <Icon name={p.icon} size={22} />
            </span>
            <h3 class="mt-3 font-semibold text-brand-900">{t(p.title)}</h3>
            <p class="mt-1.5 text-sm text-neutral-600">{t(p.text)}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
