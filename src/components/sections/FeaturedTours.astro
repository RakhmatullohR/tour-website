---
// Home §6 row 6 — 3-6 cards where featured: true.
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { TFunction } from '../../i18n/t';
import type { Tour } from '../../lib/tours';
import TourCard from '../cards/TourCard.astro';
import Button from '../ui/Button.astro';

interface Props { tours: Tour[]; locale: string; t: TFunction }
const { tours, locale, t } = Astro.props;
const featured = tours.filter((x) => x.data.featured).slice(0, 6);
---
{featured.length > 0 && (
  <section aria-labelledby="featured-h" class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-[var(--container-site)] px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="featured-h" class="text-3xl font-bold text-brand-900 sm:text-4xl">{t('featured.title')}</h2>
          <p class="mt-3 max-w-[68ch] text-neutral-600">{t('featured.subtitle')}</p>
        </div>
        <Button href={getRelativeLocaleUrl(locale, '/tours/')} variant="ghost">{t('featured.all')}</Button>
      </div>

      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((tour) => <li class="relative"><TourCard tour={tour} locale={locale} t={t} /></li>)}
      </ul>
    </div>
  </section>
)}
