---
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getImage } from 'astro:assets';
import { SHIPPED_LOCALES, DEFAULT_LOCALE, LOCALE_TAGS } from '../i18n/locales.mjs';
import { useTranslations } from '../i18n/t';
import { resolveImage, imageKeys } from '../lib/images';
import { METRICA_ID, BRAND_NAME } from '../config/site';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import FloatingWidget from '../components/sections/FloatingWidget.astro';
import FormRuntime from '../components/islands/FormRuntime.astro';

interface Props {
  locale: string;
  title: string;
  description?: string;
  /** BC8 — the exact set getStaticPaths() used to decide emission for THIS page.
   *  Drives both the hreflang cluster and the page-aware switcher, so the two can
   *  never disagree and the switcher can never link to a page that was not emitted. */
  availableLocales?: string[];
  /** Path AFTER the locale prefix, e.g. '/tours/'. Must start and end with '/'. */
  path?: string;
  /** Filename in src/assets/images used for og:image. Defaults to the OG card
   *  for THIS locale — see `ogImage` below. */
  ogImage?: string;
  /** §14 — JSON-LD blocks. Three types at launch: TravelAgency, TouristTrip,
   *  BreadcrumbList. Passed as objects, serialised once here. */
  schemas?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  locale,
  title,
  description = '',
  availableLocales = SHIPPED_LOCALES,
  path = '/',
  ogImage,
  schemas = [],
  noindex = false,
} = Astro.props;

const t = useTranslations(locale);
const canonical = new URL(getRelativeLocaleUrl(locale, path), Astro.site).href;

// PER-LOCALE OG CARD. The repo already carried og-ru (and og-en / og-ms for the
// staged locales) with the tagline set in each language, but every page shipped
// og-default regardless — so a Russian page shared to Telegram previewed with
// Uzbek text on the card. The `og-<locale>` file wins when it exists; anything
// missing falls back to og-default rather than throwing, which is what keeps
// adding a locale a one-line change in locales.mjs.
const OG_DEFAULT = 'og-default-1200x630.webp';
const localeCard = `og-${locale}-1200x630.webp`;
const ogFile = ogImage ?? (imageKeys.has(localeCard) ? localeCard : OG_DEFAULT);

// og:image must be an ABSOLUTE URL to an image that actually exists in the built
// output, so it goes through the same optimisation pipeline as everything else.
const og = await getImage({ src: resolveImage(ogFile), width: 1200, height: 630, format: 'webp' });
const ogUrl = new URL(og.src, Astro.site).href;

const alternates = availableLocales.filter((l) => SHIPPED_LOCALES.includes(l));
---
<!doctype html>
<html lang={LOCALE_TAGS[locale] ?? locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- BC11: set BEFORE any stylesheet can hide content. With JS off, .reveal is
         never hidden, so every section below the fold renders. -->
    <script is:inline>document.documentElement.classList.add('js')</script>

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* Reciprocal hreflang for locales ACTUALLY PRESENT on this page (§8.1). A
        locale whose content is missing is not emitted and never appears here. */}
    {alternates.map((l) => (
      <link rel="alternate" hreflang={LOCALE_TAGS[l] ?? l} href={new URL(getRelativeLocaleUrl(l, path), Astro.site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl(DEFAULT_LOCALE, path), Astro.site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={(LOCALE_TAGS[locale] ?? locale).replace('-', '_')} />
    {alternates.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={(LOCALE_TAGS[l] ?? l).replace('-', '_')} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />

    {/* All PNG, and no SVG entry: the client's mark is a photographic flag badge,
        so there is no honest vector of it. The old favicon.svg drew a generic
        paper plane and — being SVG — WON over these in every modern browser. */}
    <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0c4a5a" />

    {schemas.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}
  </head>

  <body class="flex min-h-screen flex-col">
    {/* §15 — the FIRST focusable element on every page. */}
    <a
      href="#main"
      class="sr-only rounded-[var(--radius-md)] bg-brand-700 px-4 py-3 text-white focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50"
    >
      {t('nav.skip')}
    </a>

    <Header locale={locale} t={t} availableLocales={availableLocales} path={path} />

    <main id="main" class="flex-1"><slot /></main>

    <Footer locale={locale} t={t} />
    <FloatingWidget t={t} locale={locale} />

    <FormRuntime t={t} />

    {METRICA_ID && (
      <div
        data-consent
        hidden
        class="fixed inset-x-3 bottom-3 z-50 mx-auto max-w-xl rounded-[var(--radius-lg)] border border-neutral-200 bg-white p-4 shadow-lg"
      >
        <p class="text-sm text-neutral-800">{t('privacy.cookies.text')}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <button data-consent-accept type="button"
            class="min-h-11 rounded-[var(--radius-md)] bg-brand-700 px-4 font-medium text-white hover:bg-brand-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700">
            OK
          </button>
          <button data-consent-decline type="button"
            class="min-h-11 rounded-[var(--radius-md)] px-4 font-medium text-brand-700 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-700">
            {t('common.close')}
          </button>
          <a href={getRelativeLocaleUrl(locale, '/privacy/')} class="flex min-h-11 items-center px-2 text-sm underline">
            {t('form.consentLink')}
          </a>
        </div>
      </div>
    )}

    <script is:inline define:vars={{ metricaId: METRICA_ID }}>
      /* PLAN §14 — YANDEX METRICA, DEFERRED, AFTER CONSENT.
       * The script tag is never inserted until the visitor accepts, so declining
       * costs zero bytes rather than loading the tracker and asking it not to
       * track. All six §14 events route through window.__gtMetrica. */
      (function () {
        var KEY = 'gt:consent';
        var box = document.querySelector('[data-consent]');
        function load() {
          if (!metricaId || window.__gtMetricaLoaded) return;
          window.__gtMetricaLoaded = true;
          (function (m, e, t, r, i, k, a) {
            m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
            m[i].l = 1 * new Date();
            k = e.createElement(t); a = e.getElementsByTagName(t)[0];
            k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
          })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
          window.ym(metricaId, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });
          window.__gtMetrica = function (event) { window.ym(metricaId, 'reachGoal', event); };
        }
        var stored = null;
        try { stored = localStorage.getItem(KEY); } catch (e) { /* storage blocked */ }
        if (stored === 'yes') load();
        else if (stored !== 'no' && box) box.hidden = false;

        function decide(value) {
          try { localStorage.setItem(KEY, value); } catch (e) { /* ignore */ }
          if (box) box.hidden = true;
          if (value === 'yes') load();
        }
        box && box.querySelector('[data-consent-accept]').addEventListener('click', function () { decide('yes'); });
        box && box.querySelector('[data-consent-decline]').addEventListener('click', function () { decide('no'); });
      })();
    </script>

    <script>
      /* §14 — ONE delegated listener fires every contact event, so no component
       * ships its own analytics JS. __gtMetrica is undefined until consent, and
       * stays undefined forever if the visitor declines — hence optional chaining. */
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-metrica]');
        const event = el?.dataset.metrica;
        if (event) window.__gtMetrica?.(event);
      });

      /* PLAN §7.3 LAYER 2 — RUNTIME NARROWING, not the correctness floor.
       * Layer 1 (build-time filtering) already dropped past departures, so this
       * only narrows further between builds. Layer 3 (the weekly cron) keeps the
       * floor from drifting more than seven days. With JS OFF the worst case is a
       * date at most seven days stale — bounded, not permanently false. */
      const today = new Date().toISOString().slice(0, 10);
      for (const time of document.querySelectorAll('[data-departure]')) {
        if ((time.getAttribute('datetime') ?? '') < today) time.remove();
      }
      for (const list of document.querySelectorAll('[data-departures-list]')) {
        if (!list.querySelector('[data-departure]')) {
          list.textContent = list.getAttribute('data-empty-label') ?? '';
        }
      }
      /* Same three-layer discipline for a promotion that expired between builds. */
      for (const promo of document.querySelectorAll<HTMLElement>('[data-promo]')) {
        if ((promo.dataset.validUntil ?? '') < today) promo.remove();
      }

      /* §13.5 scroll-reveal. BC11: the `html.js` marker is already set in <head>,
       * so with JS disabled .reveal was never hidden and everything renders. */
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible'); // once only
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
