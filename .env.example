# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# BC3 — the Telegram bot token does NOT live here and does NOT live in
# apps-script/Code.gs. It lives in Apps Script -> Project Settings ->
# Script Properties as TG_TOKEN / TG_CHAT_ID.

# Google Apps Script Web App endpoint (PLAN §9.3). Public by design: it is a
# write-only endpoint. Placeholder only in this file.
PUBLIC_FORM_ENDPOINT=https://script.google.com/macros/s/REPLACE_ME/exec

# Shared secret echoed back by the Apps Script to reject drive-by posts.
PUBLIC_FORM_TOKEN=REPLACE_ME

# Yandex Metrica counter id (Q8 — needs a YANDEX account, not a Google one).
PUBLIC_METRICA_ID=

# Deployment target base URL, used by `astro build`.
SITE_URL=https://getcar-travel.uz
